# InfraSync-AI (SIH26122) - Environment Configuration Template
# Copy this file to .env and configure your local settings.

# FastAPI Server Settings
SIH_HOST=0.0.0.0
SIH_PORT=8000
SIH_DEBUG=true

# Database Path (defaults to database/sih.db)
# SIH_DB_PATH=database/sih.db

# AI Provider ("fallback" | "openai" | "gemini")
SIH_AI_PROVIDER=fallback
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Matching Engine Confidence Policy Thresholds
SIH_AUTO_MATCH=0.85
SIH_REVIEW_THRESHOLD=0.65
